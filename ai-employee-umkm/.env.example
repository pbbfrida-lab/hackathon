# =============================================================================
# OmniStaff AI — konfigurasi
# Salin file ini menjadi .env lalu isi bagian yang Anda perlukan:
#   copy .env.example .env     (PowerShell: Copy-Item .env.example .env)
# Semua key di bawah punya free tier. Minimal satu filled = AI live;
# kosong semua = aplikasi tetap jalan dalam mode demo berbasis aturan.
# =============================================================================

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Set true kalau aplikasi dijalankan di belakang reverse proxy/ngrok
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Database (default Laragon: MySQL di 127.0.0.1, user root, tanpa password)
# Buat dulu: npm run db:init -- --seed
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ai_employee_umkm
DB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# AI — urutan percobaan. Provider yang key-nya kosong otomatis dilewati,
# dan yang error/rate-limit otomatis dilompati ke provider berikutnya.
# Nilai: groq, gemini, freebuff
# -----------------------------------------------------------------------------
AI_PROVIDER_ORDER=gemini,groq,freebuff
AI_TIMEOUT_MS=45000
AI_MAX_STEPS=5
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=900
AI_PROVIDER_SARI=gemini
AI_PROVIDER_FINANCE=gemini
AI_PROVIDER_INVENTORY=gemini
AI_PROVIDER_MARKETING=gemini

# --- 1. Groq (free tier, tanpa kartu kredit) --------------------------------
# Daftar key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Tersedia di free tier: openai/gpt-oss-120b (terbaik) | openai/gpt-oss-20b (tercepat) | qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
# Groq juga menyediakan Whisper gratis untuk transkripsi pesan suara
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- 2. Google AI Studio / Gemini (free tier) ------------------------------
# Ambil key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

# --- 3. Freebuff (Codebuff, free tier) --------------------------------------
# Freebuff tidak menyediakan REST API langsung. Jalankan adapter OpenAI-compatible
# miliknya lebih dulu, lalu arahkan base URL ke adapter tersebut:
#   freebuff2api   -> http://127.0.0.1:8000/v1
#   freebuff-proxy -> http://127.0.0.1:3457/v1
FREEBUFF_BASE_URL=http://127.0.0.1:8000/v1
FREEBUFF_API_KEY=
FREEBUFF_MODEL=deepseek/deepseek-v4-flash

# --- Speech-to-Text server-side (opsional) ----------------------------------
# auto = pakai Groq Whisper bila GROQ_API_KEY terisi; browser = hanya transkrip dari mikrofon web
STT_MODE=auto
STT_API_URL=
STT_API_KEY=

# --- API gambar untuk poster (opsional) -------------------------------------
# Kosong = poster SVG dibuat lokal (dikonversi ke PNG bila paket sharp terpasang)
IMAGE_API_URL=
IMAGE_API_KEY=

# --- Pembayaran PayPal (opsional) -------------------------------------------
# Buat REST app di developer.paypal.com, lalu isi Client ID dan Secret.
# Gunakan sandbox saat pengujian; ganti ke live hanya setelah transaksi uji berhasil.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Kurs Rupiah per 1 USD yang Anda tetapkan. PayPal checkout menggunakan USD.
PAYPAL_IDR_PER_USD=

# -----------------------------------------------------------------------------
# Keamanan API — isi untuk mengunci endpoint /api (dashboard/chat).
# Setelah diisi, frontend akan meminta key sekali lalu menyimpannya di localStorage.
# Webhook /webhook/* TIDAK dikunci oleh key ini (verifikasi token-nya sendiri).
# -----------------------------------------------------------------------------
APP_API_KEY=

# Batas pesan per menit (melindungi kuota free tier)
CHAT_RATE_LIMIT_CUSTOMER=12
CHAT_RATE_LIMIT_OWNER=60
MAX_CUSTOMER_QTY=20

# =============================================================================
# Telegram — cara paling mudah dinyalakan: hanya butuh token, tanpa URL publik.
# 1. Chat @BotFather -> /newbot -> salin token ke TELEGRAM_BOT_TOKEN
# 2. Jalankan server, kirim /start ke bot-mu
# 3. Kirim /id ke bot untuk melihat chat ID-mu
# 4. Isi TELEGRAM_OWNER_IDS dengan ID itu (pisahkan koma untuk beberapa pemilik)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_IDS=
# polling = long polling (default, paling mudah) | webhook = butuh PUBLIC_BASE_URL HTTPS
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLL_TIMEOUT=25

# =============================================================================
# WhatsApp Business Cloud API (opsional) — butuh webhook HTTPS publik (ngrok).
# Dashboard > WhatsApp > Webhooks: callback URL = <PUBLIC_BASE_URL>/webhook/whatsapp
# =============================================================================
PUBLIC_BASE_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Wajib diisi agar peran pemilik bisa diverifikasi lewat tanda tangan HMAC
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_NUMBERS=
WHATSAPP_GRAPH_VERSION=v24.0
