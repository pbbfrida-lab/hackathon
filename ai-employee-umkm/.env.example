PORT=3000

# Database (Laragon default: user root, tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ai_employee_umkm

# Meta AI (Llama API, format OpenAI-compatible). Kosongkan META_API_KEY untuk mode demo tanpa LLM.
META_API_KEY=masukkan_meta_ai_api_key_anda_di_sini
META_API_BASE_URL=https://api.llama.com/compat/v1
META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Opsional: isi untuk mengaktifkan autentikasi sederhana (header x-api-key)
APP_API_KEY=

# Opsional: endpoint pembuat gambar (kalau kosong, poster SVG dibuat lokal)
IMAGE_API_URL=
IMAGE_API_KEY=

# Opsional: endpoint Speech-to-Text server-side (kalau kosong, pakai mikrofon browser)
STT_API_URL=
STT_API_KEY=

# ---------- Kanal chat ----------
# URL publik HTTPS (ngrok / cloudflared), dibutuhkan untuk WhatsApp dan Telegram mode webhook
PUBLIC_BASE_URL=

# Telegram: buat bot lewat @BotFather. Kirim /id ke bot untuk mendapat ID Anda (pemilik).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_IDS=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta). Nomor pemilik tanpa tanda +, pisahkan koma. Contoh: 6281234567890
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_NUMBERS=
WHATSAPP_GRAPH_VERSION=v24.0
